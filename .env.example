# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file.

# ── Graph backend ───────────────────────────────────────────────
# "neo4j" to use a real Neo4j database, "memory" for the in-process store.
GRAPH_BACKEND=memory

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
# Optional: defaults to the server's default database
NEO4J_DATABASE=

# ── LLM provider ────────────────────────────────────────────────
# "mock" (offline, scripted output), "openai-compatible", or "natlas" (template only — see README)
LLM_PROVIDER=mock

# Used by the openai-compatible provider (OpenAI, Azure-compatible gateways, Ollama, vLLM, LM Studio, ...)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name

# Reserved for the N-ATLAS adapter once official API documentation is available.
NATLAS_BASE_URL=
NATLAS_API_KEY=
NATLAS_MODEL=
